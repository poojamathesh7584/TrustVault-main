{
  "name": "trustvault",
  "private": true,
  "type": "module",
  "description": "TrustVault – Digital Identity & Document Verification Portal (Full Stack Node.js + Express + MongoDB + React)",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node --watch-path=server/src server/src/index.js",
    "server:dev": "node --watch-path=server/src server/src/index.js",
    "client": "npm run dev --prefix client",
    "seed": "node server/scripts/seed.js",
    "db:inspect": "node server/scripts/inspectDb.js",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "emoji-regex": "^8.0.0",
    "escalade": "^3.2.0",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "is-fullwidth-code-point": "^3.0.0",
    "require-directory": "^2.1.1",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.9.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^7.0.0",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojamathesh7584/TrustVault-main.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/poojamathesh7584/TrustVault-main/issues"
  },
  "homepage": "https://github.com/poojamathesh7584/TrustVault-main#readme"
}
